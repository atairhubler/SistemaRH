<Window x:Class="SistemaRH.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaRH.Desktop"
        mc:Ignorable="d"
        Title="Sistema RH" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="15">
            <Grid>
                <TextBlock Text="Sistema RH - Gestão de Recursos Humanos"
                           Foreground="{DynamicResource HeaderForeground}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="{Binding TemaIcone}" HorizontalAlignment="Right"
                        Padding="10,5" Background="{DynamicResource BtnThemeBackground}"
                        Foreground="{DynamicResource HeaderForeground}" FontSize="14"
                        Command="{Binding AlternarTemaCommand}" Cursor="Hand"
                        ToolTip="Alternar entre modo claro e escuro"/>
            </Grid>
        </Border>

        <!-- Menu -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="📊 Dashboard" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding DashboardCommand}"/>
                <Button Content="🏢 Empresas" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding EmpresasCommand}"/>
                <Button Content="👥 Funcionários" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding FuncionariosCommand}"/>
                <Button Content="📋 Férias" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding FeriasCommand}"/>
                <Button Content="💰 Folha CLT" Padding="10,5" Margin="5" Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding FolhaPagamentoCommand}"/>
                <Button Content="📄 RPA/NF PJ" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding RpaNfCommand}"/>
                <Button Content="📊 Relatórios" Padding="10,5" Margin="5" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding RelatoriosCommand}"/>
                <Separator Width="1" Margin="10,0"/>
                <Button Content="⚙️ Configurações" Padding="10,5" Margin="5" Background="{DynamicResource BtnSettingsBackground}" Foreground="{DynamicResource BtnForeground}" Command="{Binding ConfiguracoesCommand}"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="15"/>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderStatusBar}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
