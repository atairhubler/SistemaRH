<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="White"/>
    <SolidColorBrush x:Key="CardBackground" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="ActionBarBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="InputBackground" Color="White"/>
    <SolidColorBrush x:Key="SalaryPrefixBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="DataGridBackground" Color="White"/>
    <SolidColorBrush x:Key="AlternatingRowBackground" Color="#F8FAFC"/>

    <!-- Header -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#78350F"/>
    <SolidColorBrush x:Key="HeaderForeground" Color="White"/>
    <SolidColorBrush x:Key="HeaderSubForeground" Color="#FDE68A"/>
    <SolidColorBrush x:Key="HeaderSubForeground2" Color="#FEF3C7"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextLabel" Color="#374151"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextFaint" Color="#9CA3AF"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderDefault" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="BorderCard" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderActionBar" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStatusBar" Color="#D1D5DB"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="BtnNavBackground" Color="#D97706"/>
    <SolidColorBrush x:Key="BtnPrimaryBackground" Color="#78350F"/>
    <SolidColorBrush x:Key="BtnSettingsBackground" Color="#6B7280"/>
    <SolidColorBrush x:Key="BtnSuccessBackground" Color="#10B981"/>
    <SolidColorBrush x:Key="BtnDangerBackground" Color="#EF4444"/>
    <SolidColorBrush x:Key="BtnExportBackground" Color="#059669"/>
    <SolidColorBrush x:Key="BtnCancelBackground" Color="#64748B"/>
    <SolidColorBrush x:Key="BtnForeground" Color="White"/>
    <SolidColorBrush x:Key="BtnThemeBackground" Color="#374151"/>

    <!-- Accent Cards -->
    <SolidColorBrush x:Key="AccentBlueBackground" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="AccentBlueBorder" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentBlueForeground" Color="#78350F"/>
    <SolidColorBrush x:Key="AccentGreenBackground" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="AccentGreenBorder" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentGreenForeground" Color="#059669"/>
    <SolidColorBrush x:Key="AccentPinkBackground" Color="#FCE7F3"/>
    <SolidColorBrush x:Key="AccentPinkBorder" Color="#EC4899"/>
    <SolidColorBrush x:Key="AccentPinkForeground" Color="#BE185D"/>
    <SolidColorBrush x:Key="AccentYellowBackground" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="AccentYellowBorder" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentYellowForeground" Color="#1E40AF"/>

    <!-- Semantic Values -->
    <SolidColorBrush x:Key="ValueGreen" Color="#059669"/>
    <SolidColorBrush x:Key="ValueRed" Color="#DC2626"/>
    <SolidColorBrush x:Key="ValueBlue" Color="#D97706"/>
    <SolidColorBrush x:Key="ValuePink" Color="#BE185D"/>
    <SolidColorBrush x:Key="ValueAmber" Color="#D97706"/>
    <SolidColorBrush x:Key="ValueDark" Color="#1F2937"/>

    <!-- DataGrid Styles -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Setter Property="Foreground" Value="#78350F"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFBEB"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="5,0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
