<UserControl x:Class="SistemaRH.Desktop.Views.GraficosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SistemaRH.Desktop.Views.Controls"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="0,0,0,1" Padding="20,15">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Empresa" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <ComboBox Width="220" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Empresas}"
                              SelectedItem="{Binding EmpresaSelecionada}"
                              DisplayMemberPath="RazaoSocial"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Período" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <ComboBox Width="170" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding OpcoesPeriodo}"
                              SelectedItem="{Binding PeriodoSelecionado}"
                              DisplayMemberPath="Rotulo"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Séries" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="34">
                        <CheckBox Content="CLT" IsChecked="{Binding MostrarCLT}" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox Content="PJ" IsChecked="{Binding MostrarPJ}" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox Content="Estagiário" IsChecked="{Binding MostrarEstagiario}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Gráficos" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="34">
                        <CheckBox Content="Quadro de Funcionários" IsChecked="{Binding MostrarQuadro}" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox Content="Custo Mensal" IsChecked="{Binding MostrarCusto}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Gráficos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15"
                        Visibility="{Binding MostrarQuadro, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Evolução do Quadro de Funcionários" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,10"/>
                        <controls:LineChartView Height="280" Series="{Binding SeriesQuadro}" Rotulos="{Binding RotulosTendencia}" FormatoValor="N0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15"
                        Visibility="{Binding MostrarCusto, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Evolução do Custo Mensal" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,10"/>
                        <controls:LineChartView Height="280" Series="{Binding SeriesCusto}" Rotulos="{Binding RotulosTendencia}" FormatoValor="C0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
