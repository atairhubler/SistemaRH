<Window x:Class="SistemaRH.Desktop.Views.EmpresaDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="620" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,15">
            <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource HeaderForeground}" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel>
                <!-- Dados principais -->
                <TextBlock Text="DADOS DA EMPRESA" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueForeground}" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Razão Social *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                             Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="CNPJ *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Inscrição Estadual" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding InscricaoEstadual, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Contato -->
                <TextBlock Text="CONTATO" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Telefone" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Endereço -->
                <TextBlock Text="ENDEREÇO" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Endereço" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                             Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Cidade" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="Estado" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="CEP" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="38"
                                 Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Botões -->
        <Border Grid.Row="2" Padding="20,15" BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="20,8" Background="{DynamicResource BtnCancelBackground}" Foreground="{DynamicResource BtnForeground}"
                        Width="110" Margin="0,0,10,0" Command="{Binding CancelarCommand}" Cursor="Hand"/>
                <Button Content="Salvar" Padding="20,8" Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}"
                        Width="110" Command="{Binding SalvarCommand}" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
