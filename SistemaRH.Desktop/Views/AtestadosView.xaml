<Window x:Class="SistemaRH.Desktop.Views.AtestadosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Atestados" Height="700" Width="720" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="15">
            <TextBlock Text="Atestados" Foreground="{DynamicResource HeaderForeground}" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Novo atestado -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="15,15,15,0">
            <StackPanel>
                <TextBlock Text="Registrar novo atestado" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Data do Atestado *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NovaDataAtestado}" Padding="8" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Início do Afastamento *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NovaDataInicio}" Padding="8" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,5,0">
                        <TextBlock Text="Fim do Afastamento *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding NovaDataFim}" Padding="8" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="5,0,0,0">
                        <TextBlock Text="Dias" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DiasFaltadosCalculado, Mode=OneWay}" Padding="8" Height="36" IsReadOnly="True"
                                 Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Tipo *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding OpcoesTipo}" SelectedItem="{Binding NovoTipo}" Padding="8" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="CID" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NovoCid, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="36"
                                 BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Descrição" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NovaDescricao, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="36" Margin="0,0,0,10"
                         BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>

                <TextBlock Text="Observações" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NovaObservacao, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="36" Margin="0,0,0,10"
                         BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>

                <TextBlock Text="Arquivo (PDF ou foto) *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="📎 Selecionar Arquivo" Padding="10,8" Command="{Binding SelecionarArquivoCommand}"
                            Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding NomeArquivoSelecionado}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>

                <Button Content="+ Registrar Atestado" Command="{Binding AdicionarCommand}" Padding="12,8"
                        Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Atestados}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeight="36"
                  Background="{DynamicResource DataGridBackground}"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBackground}"
                  BorderThickness="0" Margin="15,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DataAtestado, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="140"/>
                <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Fim" Binding="{Binding DataFim, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Dias" Binding="{Binding DiasFaltados}" Width="50"/>
                <DataGridTextColumn Header="CID" Binding="{Binding Cid}" Width="60"/>
                <DataGridTemplateColumn Header="Arquivo" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Baixar" Padding="8,4" Margin="0,0,5,0" FontSize="11"
                                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                                        Command="{Binding DataContext.BaixarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Cursor="Hand"/>
                                <Button Content="Remover" Padding="8,4" FontSize="11"
                                        Background="{DynamicResource BtnDangerBackground}" Foreground="{DynamicResource BtnForeground}"
                                        Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Padding="15">
            <Button Content="Fechar" Padding="15,8" Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Width="100" HorizontalAlignment="Right" Command="{Binding FecharCommand}"/>
        </Border>
    </Grid>
</Window>
