<Window x:Class="SistemaRH.Desktop.Views.TabelasCalculoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabelas de Cálculo — INSS e IRRF"
        Width="940" Height="540"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBackground}"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tabelas de Cálculo" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource HeaderForeground}"/>
                    <TextBlock Text="Edite as faixas de INSS e IRRF utilizadas nos cálculos de holerite"
                               FontSize="11" Foreground="{DynamicResource HeaderSubForeground}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,20,4">
            <StackPanel>
                <!-- Tabelas lado a lado -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- INSS -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="INSS — Tabela Progressiva" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cada faixa incide apenas sobre a parcela do salário dentro do intervalo."
                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding FaixasINSS}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="False" RowHeight="34" HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderDefault}"
                                  Background="{DynamicResource DataGridBackground}"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Faixa" Binding="{Binding Descricao}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="Limite Superior (R$)" Binding="{Binding LimiteSuperior, StringFormat=N2}" Width="*"/>
                                <DataGridTextColumn Header="Alíquota (%)" Binding="{Binding AliquotaPercent, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- IRRF -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="IRRF — Tabela Simplificada" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="Alíquota sobre a base de cálculo inteira, menos a dedução fixa da faixa."
                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding FaixasIRRF}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="False" RowHeight="34" HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderDefault}"
                                  Background="{DynamicResource DataGridBackground}"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Faixa" Binding="{Binding Descricao}" IsReadOnly="True" Width="60"/>
                                <DataGridTemplateColumn Header="Limite Superior (R$)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LimiteSuperiorDisplay}" VerticalAlignment="Center" Padding="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding LimiteSuperior, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding PodeEditarLimite}"
                                                     VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Alíquota (%)" Binding="{Binding AliquotaPercent, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="Dedução (R$)" Binding="{Binding Deducao, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

                <!-- Dedução por dependente -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                    <TextBlock Text="Dedução por dependente:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,8,0"/>
                    <TextBlock Text="R$" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding DeducaoPorDependenteConfig, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             Width="110" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de ações -->
        <Border Grid.Row="2" Background="{DynamicResource ActionBarBackground}"
                BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↺ Restaurar Padrão 2024" Command="{Binding RestaurarPadraoCommand}"
                            Background="{DynamicResource BtnCancelBackground}" Foreground="{DynamicResource BtnForeground}"
                            Padding="15,0" Height="34" Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Redefine para as tabelas oficiais de 2024"/>
                    <Button Content="💾 Salvar Tabelas" Command="{Binding SalvarTabelasCommand}"
                            Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}"
                            Padding="20,0" Height="34" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
