<UserControl x:Class="SistemaRH.Desktop.Views.RpaNfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="RPA / Notas Fiscais" FontSize="24" FontWeight="Bold" Margin="20,20,20,15" Foreground="{DynamicResource AccentBlueForeground}"/>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,15">
            <StackPanel Width="100" Margin="0,0,10,0">
                <TextBlock Text="Mês:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                <ComboBox SelectedItem="{Binding MesSelecionado}" Padding="8" Height="40">
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                    <ComboBoxItem>9</ComboBoxItem>
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>11</ComboBoxItem>
                    <ComboBoxItem>12</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Width="100" Margin="0,0,10,0">
                <TextBlock Text="Ano:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding AnoSelecionado}" Padding="8" Height="40"/>
            </StackPanel>

            <Button Content="🔍 Filtrar" Padding="10,5" Margin="0,25,10,0"
                    Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                    Command="{Binding FiltrarCommand}"/>
            <Button Content="➕ Nova RPA" Padding="10,5" Margin="0,25,0,0"
                    Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}"
                    Command="{Binding NovaRpaCommand}"/>
        </StackPanel>

        <!-- DataGrid RPA/NF -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding RpasNfs}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="20,0,20,0"
                  Background="{DynamicResource DataGridBackground}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding NumeroDocumento}" Width="120"/>
                <DataGridTextColumn Header="PJ" Binding="{Binding FuncionarioPJId}" Width="100"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDocumento}" Width="80"/>
                <DataGridTextColumn Header="Competência"
                                   Binding="{Binding Mes, StringFormat={}{0:00}/{Binding Ano}}" Width="100"/>
                <DataGridTextColumn Header="Valor Bruto" Binding="{Binding ValorBruto, StringFormat='R$ {0:F2}'}" Width="120"/>
                <DataGridTextColumn Header="Descontos" Binding="{Binding ValorDescontos, StringFormat='R$ {0:F2}'}" Width="100"/>
                <DataGridTextColumn Header="Valor Líquido" Binding="{Binding ValorLiquido, StringFormat='R$ {0:F2}'}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusPagamento}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderStatusBar}" BorderThickness="0,1,0,0" Padding="10,10,10,5" Margin="20,15,20,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
