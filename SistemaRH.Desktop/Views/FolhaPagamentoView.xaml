<UserControl x:Class="SistemaRH.Desktop.Views.FolhaPagamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Folha de Pagamento" Foreground="{DynamicResource HeaderForeground}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" — Cálculo de holerite CLT (INSS, IRRF, FGTS)" Foreground="{DynamicResource HeaderSubForeground}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Barra de entrada -->
        <Border Grid.Row="1" Background="{DynamicResource ActionBarBackground}" BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Funcionário CLT" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Funcionarios}"
                              SelectedItem="{Binding FuncionarioSelecionado}"
                              DisplayMemberPath="Nome"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Text="{Binding FiltroNome, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyUp="FuncionarioFiltro_PreviewKeyUp"
                              Height="22" Padding="8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Mês" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MesSelecionado, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="8,0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Ano" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AnoSelecionado, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="8,0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,15,0">
                    <TextBlock Text="Dependentes" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NumeroDependentes, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="8,0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                </StackPanel>

                <Button Grid.Column="4" Content="📊 Calcular" Command="{Binding CalcularCommand}"
                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                        Padding="15,0" Height="36" Margin="0,20,10,0" FontWeight="Bold" Cursor="Hand"/>

                <Button Grid.Column="5" Content="📥 Excel" Command="{Binding ExportarExcelCommand}"
                        Background="{DynamicResource BtnExportBackground}" Foreground="{DynamicResource BtnForeground}"
                        Padding="15,0" Height="36" Margin="0,20,10,0" Cursor="Hand"/>

                <Button Grid.Column="6" Content="⚙️ Tabelas" Command="{Binding AbrirTabelasCommand}"
                        Background="{DynamicResource BtnSettingsBackground}" Foreground="{DynamicResource BtnForeground}"
                        Padding="12,0" Height="36" Margin="0,20,0,0" Cursor="Hand"
                        ToolTip="Editar tabelas de cálculo INSS e IRRF"/>
            </Grid>
        </Border>

        <!-- Resultado / placeholder -->
        <Grid Grid.Row="2" Margin="20" MinHeight="280">
            <!-- Placeholder -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{Binding MostrarResultado, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Selecione um funcionário e clique em Calcular" FontSize="14" HorizontalAlignment="Center"
                               Margin="0,10,0,0" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Holerite -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1" CornerRadius="8" Padding="0"
                    Visibility="{Binding MostrarResultado, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header holerite -->
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" CornerRadius="8,8,0,0" Padding="25,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="HOLERITE DE PAGAMENTO" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource HeaderForeground}"/>
                                <TextBlock Text="{Binding Resultado.Competencia, StringFormat='Competência: {0}'}"
                                           FontSize="13" Foreground="{DynamicResource HeaderSubForeground}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Resultado.NomeFuncionario}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource HeaderForeground}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Resultado.Cargo}" FontSize="12"
                                           Foreground="{DynamicResource HeaderSubForeground}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Corpo -->
                    <Grid Grid.Row="1" Margin="25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Proventos -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROVENTOS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentGreenForeground}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Salário Bruto" Foreground="{DynamicResource TextLabel}" FontSize="13"/>
                                <TextBlock Text="{Binding Resultado.SalarioBruto, StringFormat='R$ {0:N2}'}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource AccentGreenForeground}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Descontos -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DESCONTOS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ValueRed}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="INSS" Foreground="{DynamicResource TextLabel}" FontSize="13"/>
                                <TextBlock Text="{Binding Resultado.DescontoINSS, StringFormat='R$ {0:N2}'}"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource ValueRed}" FontSize="13"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="IRRF" Foreground="{DynamicResource TextLabel}" FontSize="13"/>
                                <TextBlock Text="{Binding Resultado.DescontoIRRF, StringFormat='R$ {0:N2}'}"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource ValueRed}" FontSize="13"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Total Descontos" Foreground="{DynamicResource TextLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Resultado.TotalDescontos, StringFormat='R$ {0:N2}'}"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource ValueRed}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderCard}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8" Padding="25,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SALÁRIO LÍQUIDO" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueForeground}"/>
                                <TextBlock Text="{Binding Resultado.SalarioLiquido, StringFormat='R$ {0:N2}'}"
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="FGTS (encargo empresa)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding Resultado.FGTS, StringFormat='R$ {0:N2}'}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ValueAmber}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="CUSTO TOTAL EMPRESA" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding Resultado.CustoTotalEmpresa, StringFormat='R$ {0:N2}'}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
