<Window x:Class="SistemaRH.Desktop.Views.FuncionarioPJDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:beh="clr-namespace:SistemaRH.Desktop.Behaviors"
        mc:Ignorable="d"
        Title="{Binding Titulo}" Height="860" Width="880" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CamposPersonalizadosResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="15">
            <Grid>
                <TextBlock Text="Cadastro de Funcionário PJ" Foreground="{DynamicResource HeaderForeground}" FontSize="18" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding PodeVerHistorico, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Atestados" Padding="10,5" FontSize="11" Margin="0,0,10,0"
                            Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                            Command="{Binding AbrirAtestadosCommand}"/>
                    <Button Content="Histórico de Valores" Padding="10,5" FontSize="11"
                            Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                            Command="{Binding AbrirHistoricoCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel>
                <!-- Seção: Foto -->
                <StackPanel Margin="0,10,0,20" HorizontalAlignment="Left">
                    <Grid Width="100" Height="100">
                        <Ellipse Fill="{DynamicResource CardBackground}" Stroke="{DynamicResource BorderCard}" StrokeThickness="1"/>
                        <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <Button Content="📷 Selecionar Foto" Command="{Binding SelecionarFotoCommand}" Padding="10,6" Margin="0,8,0,0"
                            Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" HorizontalAlignment="Left" Cursor="Hand"/>
                </StackPanel>

                <!-- Seção: Empresa contratante -->
                <TextBlock Text="EMPRESA CONTRATANTE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Empresa *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <ComboBox Height="40" Padding="10,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Empresas}"
                              SelectedItem="{Binding EmpresaSelecionada}"
                              DisplayMemberPath="RazaoSocial"/>
                </StackPanel>

                <!-- Seção: Dados da Empresa PJ -->
                <TextBlock Text="DADOS DA EMPRESA PJ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Razão Social *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="CNPJ *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding CNPJ, UpdateSourceTrigger=PropertyChanged}" MaxLength="18"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Email Empresa" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding EmailEmpresa, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Telefone Pessoal" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40"
                                 Text="{Binding Telefone, UpdateSourceTrigger=LostFocus}" MaxLength="20"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Telefone Agil" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40"
                                 Text="{Binding TelefoneAgil, UpdateSourceTrigger=LostFocus}" MaxLength="20"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Contratante" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Contratante, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Seção: Contrato -->
                <TextBlock Text="CONTRATO" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,15,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Data Início" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataInicio}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Data Término" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataFim}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Validade do Contrato" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding ValidadeContrato, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Tipo de Serviço" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding TipoServico, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Valor do Serviço Contratado" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding ValorContratado, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Valor Atual *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding ValorServico, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Departamento" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <CheckBox Content="Emite Nota Fiscal" IsChecked="{Binding EmiteNF, UpdateSourceTrigger=PropertyChanged}" Padding="10,5" Margin="0,20,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Dia da Solicitação da NF" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding DiaSolicitacaoNF, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Seção: Férias -->
                <TextBlock Text="FÉRIAS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,15,0,15"/>

                <CheckBox Content="Tem direito a férias" Padding="10,5" Margin="0,0,0,10" IsChecked="{Binding TemDireitoFerias, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Férias remuneradas" Padding="10,5" Margin="0,0,0,15" IsChecked="{Binding FeriasRemuneradas, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Seção: Dados Adicionais -->
                <TextBlock Text="DADOS ADICIONAIS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,15,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Data de Nascimento *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataNascimento}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Gênero" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Genero, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Ramal" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Ramal, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Ajuda de Custo" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding AjudaDeCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Dados Bancários" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding DadosBancarios, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Endereço" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Complemento (apto, bloco, etc.)" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Complemento, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Cidade" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Estado" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="CEP" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Comissionado" IsChecked="{Binding Comissionado, UpdateSourceTrigger=PropertyChanged}" Padding="10,5" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Observações" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Campos Adicionais (definidos em Configurações > Campos Personalizados) -->
                <StackPanel Visibility="{Binding TemCamposPersonalizados, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="CAMPOS ADICIONAIS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>
                    <ItemsControl ItemsSource="{Binding CamposPersonalizados}" ItemTemplate="{StaticResource CampoPersonalizadoTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botões -->
        <Border Grid.Row="2" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="15,8" Background="{DynamicResource BtnDangerBackground}" Foreground="{DynamicResource BtnForeground}" Width="100" Margin="0,0,10,0" Command="{Binding CancelarCommand}"/>
                <Button Content="Salvar" Padding="15,8" Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}" Width="100" Command="{Binding SalvarCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
