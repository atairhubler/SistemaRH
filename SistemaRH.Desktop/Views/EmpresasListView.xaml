<UserControl x:Class="SistemaRH.Desktop.Views.EmpresasListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Empresas" Foreground="{DynamicResource HeaderForeground}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" — Gerencie as empresas cadastradas" Foreground="{DynamicResource HeaderSubForeground}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Barra de ações -->
        <Border Grid.Row="1" Background="{DynamicResource ActionBarBackground}" Padding="20,10" BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Nova Empresa" Command="{Binding NovaEmpresaCommand}"
                        Background="{DynamicResource BtnPrimaryBackground}" Foreground="{DynamicResource BtnForeground}" Padding="15,8"
                        FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Empresas}"
                  SelectedItem="{Binding EmpresaSelecionada}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeight="44"
                  Background="{DynamicResource DataGridBackground}"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBackground}"
                  BorderThickness="0" Margin="20,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Razão Social" Binding="{Binding RazaoSocial}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="160"/>
                <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="70"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="130"/>
                <DataGridTextColumn Header="Funcionários" Binding="{Binding TotalFuncionarios}" Width="100"/>
                <DataGridTemplateColumn Header="Ações" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Editar" Padding="8,4" Margin="0,0,5,0"
                                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"/>
                                <Button Content="Excluir" Padding="8,4"
                                        Background="{DynamicResource BtnDangerBackground}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
