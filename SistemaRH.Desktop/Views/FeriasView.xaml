<UserControl x:Class="SistemaRH.Desktop.Views.FeriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Gestão de Férias" FontSize="24" FontWeight="Bold" Margin="20,20,20,15" Foreground="{DynamicResource AccentBlueForeground}"/>

        <!-- Seleção de Funcionário -->
        <Grid Grid.Row="1" Margin="20,0,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding Funcionarios}"
                      SelectedItem="{Binding SelectedFuncionario}"
                      DisplayMemberPath="Nome" Padding="10" Height="40"/>
            <Button Grid.Column="1" Content="📊 Calcular Direito" Padding="10,5" Margin="10,0,0,0"
                    Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                    Command="{Binding CalcularCommand}"/>
        </Grid>

        <!-- Painel de Férias -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Info Férias (esquerda) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Informações de Férias" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,0,0,15"/>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Dias Disponíveis:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FeriasAtual.DiasDisponiveis, StringFormat='{}{0} dias'}"
                                  FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ValueGreen}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Dias Utilizados:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FeriasAtual.DiasUtilizados, StringFormat='{}{0} dias'}"
                                  FontSize="18" Foreground="{DynamicResource ValueRed}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Dias Remunerados:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FeriasAtual.DiasRemunerados, StringFormat='{}{0} dias'}"
                                  FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Dias Não Remunerados:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FeriasAtual.DiasNaoRemunerados, StringFormat='{}{0} dias'}"
                                  FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Saldo Disponível:" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FeriasAtual.SaldoDisponivel, StringFormat='{}{0} dias'}"
                                  FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ValueBlue}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Adicionar Período (direita) -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Adicionar Período de Férias" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,0,0,15"/>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Data Inicial:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding DataInicio}" Padding="10" Height="40"
                                   BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Data Final:" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding DataFim}" Padding="10" Height="40"
                                   BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"/>
                    </StackPanel>

                    <CheckBox Content="Férias Remuneradas" IsChecked="{Binding Remunerada}" Padding="10,5" Margin="0,0,0,15"/>

                    <Button Content="➕ Adicionar Período" Padding="10,8"
                           Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}"
                           Command="{Binding AdicionarPeriodoCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderStatusBar}" BorderThickness="0,1,0,0" Padding="10,10,10,5" Margin="20,15,20,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
