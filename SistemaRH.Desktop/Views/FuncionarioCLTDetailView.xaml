<Window x:Class="SistemaRH.Desktop.Views.FuncionarioCLTDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:beh="clr-namespace:SistemaRH.Desktop.Behaviors"
        mc:Ignorable="d"
        Title="{Binding Titulo}" Height="900" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="15">
            <Grid>
                <TextBlock Text="Cadastro de Funcionário CLT" Foreground="{DynamicResource HeaderForeground}" FontSize="18" FontWeight="Bold"/>
                <Button Content="Histórico de Valores" HorizontalAlignment="Right" Padding="10,5" FontSize="11"
                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}"
                        Command="{Binding AbrirHistoricoCommand}" Visibility="{Binding PodeVerHistorico, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel>
                <!-- Seção: Empresa -->
                <TextBlock Text="EMPRESA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Empresa *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <ComboBox Height="40" Padding="10,0"
                              ItemsSource="{Binding Empresas}"
                              SelectedItem="{Binding EmpresaSelecionada}"
                              DisplayMemberPath="RazaoSocial"/>
                </StackPanel>

                <!-- Seção: Dados Básicos -->
                <TextBlock Text="DADOS BÁSICOS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,10,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Nome *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="CPF *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding CPF, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="RG" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding RG, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="Código" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Email Agil" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding EmailAgil, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Telefone" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40"
                                 Text="{Binding Telefone, UpdateSourceTrigger=LostFocus}" MaxLength="20"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Contratante" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Contratante, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Seção: Dados Profissionais -->
                <TextBlock Text="DADOS PROFISSIONAIS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,15,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Cargo *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Departamento" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Data Admissão *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataAdmissao, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Salário Bruto *" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10"
                                     BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding SalarioBruto, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Data de Nascimento" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataNascimento, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Data de Demissão" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" SelectedDate="{Binding DataDemissao, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="CTPS" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding CTPS, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="PIS/PASEP" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding PisPasep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Complemento Salarial" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding ComplementoSalarial, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Auxílio Educação" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding AuxilioEducacao, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Total Salário Atual (calculado)" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TotalAtual, StringFormat='{}{0:C2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ValueGreen}"/>
                </StackPanel>

                <!-- Seção: Dados Adicionais -->
                <TextBlock Text="DADOS ADICIONAIS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,15,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Gênero" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Genero, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Ramal" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Ramal, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="Ajuda de Custo" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1,1,0,1" Padding="10,0">
                                <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                     beh:MoedaMask.Valor="{Binding AjudaDeCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Dados Bancários" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding DadosBancarios, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Endereço" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Complemento (apto, bloco, etc.)" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Complemento, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Cidade" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Estado" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Estado, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="CEP" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                        <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40" Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Comissionado" IsChecked="{Binding Comissionado, UpdateSourceTrigger=PropertyChanged}" Padding="10,5" Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Observações" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>
                    <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botões -->
        <Border Grid.Row="2" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="15,8" Background="{DynamicResource BtnDangerBackground}" Foreground="{DynamicResource BtnForeground}" Width="100" Margin="0,0,10,0" Command="{Binding CancelarCommand}"/>
                <Button Content="Salvar" Padding="15,8" Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}" Width="100" Command="{Binding SalvarCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
