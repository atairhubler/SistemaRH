<UserControl x:Class="SistemaRH.Desktop.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Auditoria" Foreground="{DynamicResource HeaderForeground}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" — Histórico de alterações no sistema" Foreground="{DynamicResource HeaderSubForeground}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Barra de filtros -->
        <Border Grid.Row="1" Background="{DynamicResource ActionBarBackground}" Padding="20,10" BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="200" Height="34" Padding="10,0"
                         Text="{Binding FiltroUsuario, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderDefault}"
                         Tag="🔍 Filtrar por usuário..."/>
                <TextBlock Text="De:" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource TextLabel}"/>
                <DatePicker Width="130" Height="34" SelectedDate="{Binding DataInicio}"/>
                <TextBlock Text="Até:" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource TextLabel}"/>
                <DatePicker Width="130" Height="34" SelectedDate="{Binding DataFim}"/>
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" Margin="15,0,0,0"
                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" Padding="15,8" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Lista + detalhes -->
        <Grid Grid.Row="2" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding LogSelecionado}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeight="40"
                      Background="{DynamicResource DataGridBackground}"
                      AlternatingRowBackground="{DynamicResource AlternatingRowBackground}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="110"/>
                    <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="100"/>
                    <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="120"/>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" MinWidth="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="5" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detalhes da alteração" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlueForeground}" Margin="0,0,0,10"/>

                        <StackPanel Visibility="{Binding TemLogSelecionado, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LogSelecionado.Descricao}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Antes" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextLabel}" Margin="0,10,0,5"/>
                            <TextBlock Text="{Binding LogSelecionado.ValoresAntes}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>

                            <TextBlock Text="Depois" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextLabel}" Margin="0,15,0,5"/>
                            <TextBlock Text="{Binding LogSelecionado.ValoresDepois}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>

                        <TextBlock Text="Selecione um registro na lista para ver os detalhes."
                                   FontSize="12" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                                   Visibility="{Binding TemLogSelecionado, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
