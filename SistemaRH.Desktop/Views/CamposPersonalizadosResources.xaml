<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:beh="clr-namespace:SistemaRH.Desktop.Behaviors">

    <DataTemplate x:Key="CampoPersonalizadoTemplate">
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="{Binding RotuloExibicao}" FontSize="12" Foreground="{DynamicResource TextLabel}" Margin="0,0,0,5"/>

            <!-- Texto: TextBox simples -->
            <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40"
                     Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding EhTexto, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Número: só dígitos -->
            <TextBox Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Height="40"
                     Text="{Binding ValorNumero, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding EhNumero, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Monetário: mesmo padrão "R$" usado no cadastro de Funcionário -->
            <Grid Height="40" Visibility="{Binding EhMonetario, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SalaryPrefixBackground}" BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1,1,0,1" Padding="10,0">
                    <TextBlock Text="R$" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                </Border>
                <TextBox Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                         beh:MoedaMask.Valor="{Binding ValorDecimal, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Data -->
            <DatePicker Padding="10" Height="40" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                        SelectedDate="{Binding ValorData, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding EhData, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Checkbox -->
            <CheckBox Content="Sim" IsChecked="{Binding ValorBool}" Foreground="{DynamicResource TextLabel}" VerticalAlignment="Center" Height="24"
                      Visibility="{Binding EhCheckbox, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Lista de opções -->
            <ComboBox Height="40" Padding="10,0" VerticalContentAlignment="Center"
                      ItemsSource="{Binding OpcoesLista}" SelectedItem="{Binding Valor}"
                      Visibility="{Binding EhLista, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
