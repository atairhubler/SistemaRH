<UserControl x:Class="SistemaRH.Desktop.Views.FuncionariosListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Funcionários" Foreground="{DynamicResource HeaderForeground}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" — Gerencie os funcionários cadastrados" Foreground="{DynamicResource HeaderSubForeground}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Barra de ações -->
        <Border Grid.Row="1" Background="{DynamicResource ActionBarBackground}" Padding="20,10" BorderBrush="{DynamicResource BorderActionBar}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Novo Funcionário" Command="{Binding NovoCommand}"
                        Background="{DynamicResource BtnPrimaryBackground}" Foreground="{DynamicResource BtnForeground}" Padding="15,8"
                        FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="Exportar CSV" Command="{Binding ExportarCsvCommand}"
                        Background="{DynamicResource BtnExportBackground}" Foreground="{DynamicResource BtnForeground}" Padding="15,8"
                        Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="Importar Planilha da Agil Telecom" Command="{Binding ImportarPlanilhaCommand}"
                        Background="{DynamicResource BtnExportBackground}" Foreground="{DynamicResource BtnForeground}" Padding="15,8"
                        Cursor="Hand" Margin="0,0,20,0"/>
                <ComboBox Width="130" Padding="8,0" Height="34" SelectedIndex="0"
                          SelectionChanged="FiltroTipo_Changed">
                    <ComboBoxItem>Todos</ComboBoxItem>
                    <ComboBoxItem>CLT</ComboBoxItem>
                    <ComboBoxItem>PJ</ComboBoxItem>
                    <ComboBoxItem>Estagiário</ComboBoxItem>
                </ComboBox>
                <ComboBox Width="110" Padding="8,0" Height="34" Margin="10,0,0,0" SelectedIndex="0"
                          SelectionChanged="FiltroStatus_Changed">
                    <ComboBoxItem>Ativos</ComboBoxItem>
                    <ComboBoxItem>Inativos</ComboBoxItem>
                    <ComboBoxItem>Todos</ComboBoxItem>
                </ComboBox>
                <TextBox Width="220" Height="34" Margin="10,0,0,0" Padding="10,0"
                         Text="{Binding FiltroNome, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderDefault}"
                         Tag="🔍 Buscar por nome...">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <Label Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}"
                                               Foreground="{DynamicResource TextFaint}" Padding="2,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Funcionarios}"
                  SelectedItem="{Binding SelectedFuncionario}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeight="44"
                  Background="{DynamicResource DataGridBackground}"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBackground}"
                  BorderThickness="0" Margin="20,10">

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{DynamicResource CardBackground}" Stroke="{DynamicResource BorderCard}" StrokeThickness="1"/>
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource ByteArrayToImageSourceConverter}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTemplateColumn Header="Ações" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Perfil" Padding="8,4" Margin="0,0,5,0"
                                        Background="{DynamicResource AccentBlueBorder}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.PerfilCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"/>
                                <Button Content="Editar" Padding="8,4" Margin="0,0,5,0"
                                        Background="{DynamicResource BtnNavBackground}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"/>
                                <Button Content="Desativar" Padding="8,4"
                                        Background="{DynamicResource BtnDangerBackground}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.DesativarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsAtivo, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Cursor="Hand"/>
                                <Button Content="Ativar" Padding="8,4"
                                        Background="{DynamicResource BtnSuccessBackground}" Foreground="{DynamicResource BtnForeground}" FontSize="11"
                                        Command="{Binding DataContext.AtivarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsAtivo, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
